import os
import json
import base64
import requests

def branch_exists(organization, project, repo_id, branch_name, headers):
    ref_url = (
        f"https://dev.azure.com/{organization}/{project}/_apis/git/repositories/"
        f"{repo_id}/refs?filter=heads/{branch_name}&api-version=6.0"
    )
    response = requests.get(ref_url, headers=headers)
    if response.status_code != 200:
        return False
    data = response.json()
    return bool(data.get('value'))

def main():
    token = os.getenv('TOKEN')
    organization = os.getenv('ORGANIZATION_NAME')
    project = os.getenv('PROJECT_NAME')
    branches_json = os.getenv('SEARCHABLE_BRANCHES')

    target_policy_type_id = "0517f88d-4ec5-4343-9d26-9930ebd53069"

    if not all([token, organization, project, branches_json]):
        raise ValueError("TOKEN, ORGANIZATION_NAME, PROJECT_NAME, and SEARCHABLE_BRANCHES are required.")

    try:
        repo_branch_list = json.loads(branches_json)
    except json.JSONDecodeError:
        raise ValueError("Invalid JSON format in SEARCHABLE_BRANCHES.")

    encoded_token = base64.b64encode(f':{token}'.encode('ascii')).decode('ascii')
    headers = {
        'Content-Type': 'application/json',
        'Authorization': f'Basic {encoded_token}'
    }

    repos_url = f'https://dev.azure.com/{organization}/{project}/_apis/git/repositories?api-version=6.0'
    repos_response = requests.get(repos_url, headers=headers)
    repos_response.raise_for_status()
    repos_data = repos_response.json().get("value", [])
    name_to_id = {r["name"]: r["id"] for r in repos_data}

    all_policies_url = f'https://dev.azure.com/{organization}/{project}/_apis/policy/configurations?api-version=7.1-preview.1'
    all_policies_resp = requests.get(all_policies_url, headers=headers)
    all_policies_resp.raise_for_status()
    existing_policies = all_policies_resp.json().get("value", [])

    def find_existing_policy(policy_type_id, repo_id):
        for pol in existing_policies:
            if pol["type"]["id"] == policy_type_id:
                scopes = pol["settings"].get("scope", [])
                if len(scopes) == 1 and scopes[0].get("repositoryId") == repo_id:
                    return pol["id"]
        return None

    for item in repo_branch_list:
        repo_name = item["repository"]
        branch_names = item["branch"]

        if repo_name not in name_to_id:
            raise ValueError(f"Repository '{repo_name}' not found in Azure DevOps project '{project}'.")

        repo_id = name_to_id[repo_name]

        valid_branches = []
        for br in branch_names:
            if branch_exists(organization, project, repo_id, br, headers):
                valid_branches.append(f"refs/heads/{br}")
            else:
                print(f"Warning: Branch '{br}' does not exist in repository '{repo_name}'. Skipping it.")

        if not valid_branches:
            print(f"No valid branches found for repository '{repo_name}'. Policy not created/updated.")
            continue

        scope_list = [{"repositoryId": repo_id}]
        body = {
            "type": {"id": target_policy_type_id},
            "isBlocking": False,
            "isEnabled": False,
            "settings": {
                "scope": scope_list,
                "searchBranches": valid_branches
            }
        }

        existing_config_id = find_existing_policy(target_policy_type_id, repo_id)
        if existing_config_id is not None:
            update_url = (
                f"https://dev.azure.com/{organization}/{project}/_apis/policy/Configurations/"
                f"{existing_config_id}?api-version=7.1-preview.1"
            )
            response = requests.put(update_url, headers=headers, json=body)
            action = f"UPDATED policy {existing_config_id}"
        else:
            create_url = (
                f"https://dev.azure.com/{organization}/{project}/_apis/policy/configurations"
                f"?api-version=7.1-preview.1"
            )
            response = requests.post(create_url, headers=headers, json=body)
            action = "CREATED new policy"

        if not response.ok:
            raise Exception(
                f"Failed to {action} for repository '{repo_name}'.\n"
                f"Status: {response.status_code}\n"
                f"Response: {response.text}"
            )

        result_json = response.json()
        config_id = result_json.get("id", "unknown")
        print(f"{action} for repository '{repo_name}' (policy id={config_id}).")
        print("Server response:")
        print(json.dumps(result_json, indent=2), "\n")

if __name__ == "__main__":
    main()
export SEARCHABLE_BRANCHES='[
    {"repository": "eks_test", "branch": ["keda","test"]},
    {"repository": "F", "branch": ["feature/add-functions"]}
]'
